# ============================================================
# 项目级 R8 keep 规则（AGP 自动合并 src/main/keepRules 下的 *.keep 给 R8）
# ============================================================

# ---- Rust 后端 JNI 入口 ----
# 关键：RustBackend 的类名 + 外部 native 方法名不能被重命名。
# libneteasy_backend.so 导出的符号是 Java_top_yunov_neteasy_RustBackend_start，
# 一旦 R8 把类或方法改名，符号对不上，会抛 UnsatisfiedLinkError，内嵌后端直接起不来。
-keepclasseswithmembernames class top.yunov.neteasy.RustBackend {
    native <methods>;
}

# 兜底：所有带 native 方法的类都保留成员名
-keepclasseswithmembernames class * {
    native <methods>;
}

# ---- org.json ----
# org.json 内部的 JSONObject/JSONTokener 等对传入对象做反射式包装，
# 保留整棵类树，避免混淆后运行时 NoSuchMethod / 字段错位。
-keep class org.json.** { *; }

# ---- vendored AMLL 渲染器（top.met6.amll） ----
# 模块不大，整体 keep，避免任何 Compose/反射相关的意外裁掉导致歌词渲染异常。
-keep class top.met6.amll.** { *; }

# ---- Kyant0/AndroidLiquidGlass（io.github.kyant0:backdrop） ----
# 之前引入这个库在 release 包上崩过，没排除过是不是 R8 裁剪/改名导致的
# （这个库自己的 consumer-rules.pro 是空的，没有内置保护）。这次先整体 keep 住，
# 如果加了这条规则还是崩，就能排除 R8 这个嫌疑，缩小到渲染管线本身的问题。
-keep class com.kyant.backdrop.** { *; }
-keepclassmembers class com.kyant.backdrop.** { *; }
