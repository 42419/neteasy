<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Node 后端访问网易云需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务：保持 Node 后端在后台存活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 前台服务：播放通知（锁屏/通知栏控制），Android 14+ 需要显式声明该类型权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 前台服务通知（缺失时服务照常运行，仅通知不可见） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 检查更新：自己触发安装包安装需要这个权限，Android 8+ 才能弹出「允许安装未知来源应用」 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NeteasyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Neteasy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Neteasy"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 以下页面拆成独立 Activity，交给系统接管原生页面转场动画（不自己模拟）；
             parentActivityName 是为了让系统「上滑手势/Up 按钮」知道逻辑上的父页面是谁 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neteasy" />
        <activity
            android:name=".StorageActivity"
            android:exported="false"
            android:label="存储空间"
            android:parentActivityName=".SettingsActivity"
            android:theme="@style/Theme.Neteasy" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="登录"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neteasy" />
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:label="搜索"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neteasy"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PlaylistActivity"
            android:exported="false"
            android:label="歌单"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Neteasy" />

        <!-- 内嵌 Node.js 后端前台服务 -->
        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 播放前台服务：锁屏/通知栏控制条 + 音频焦点/蓝牙耳机物理按键响应 -->
        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

        <!-- 检查更新：本 App 被新版本安装包替换完成后收到这个广播，借机自动清理下载的安装包 -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
